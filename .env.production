# Production build values for https://kings-slide.pages.dev.
# kings-slide is a Cloudflare Pages *Direct Upload* project: Cloudflare never runs
# `npm run build`, so Pages-dashboard env vars never reach the bundle. VITE_ values
# must exist here (or in the shell) when you build on your machine before
# `wrangler pages deploy`. Only public values belong here (Supabase URL + anon key;
# RLS protects the data). Server keys (FL511_API_KEY, TRANSIT_FEEDS) are Pages secrets.
VITE_SUPABASE_URL=https://zmriqctjkhwmhuvxyhdd.supabase.co
# VITE_SUPABASE_ANON_KEY=  ← add the anon key here (or pass it in the shell at build time)
